{
  "name": "arlaf",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-Agent-RL：基于对抗反馈（Agent-RLAF）与协作反馈（Agent-RLCF）的多智能体强化学习框架",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:server": "pnpm --filter @arlaf/server dev",
    "dev:web": "pnpm --filter @arlaf/web dev"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
